# ===========================================
# API Environment Variables (apps/api)
# ===========================================

# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
# Vercel Postgres provides this automatically via integration
DATABASE_URL=postgresql://user:password@localhost:5432/nacker_news

# JWT Configuration (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token expiration in minutes (optional, default: 60*24*7 = 10080 = 7 days)
JWT_EXPIRATION_MINUTES=10080

# CORS Origins (optional)
# Comma-separated list of allowed origins
# Leave empty to allow all origins in development
CORS_ORIGINS=http://localhost:3000

# Vercel KV (optional, for rate limiting)
# Provided automatically by Vercel KV integration
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===========================================
# Web Environment Variables (apps/web)
# ===========================================

# API Base URL (required for web app)
# Set to your deployed API URL in production
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
